
## <summary>policy for steam</summary>

########################################
## <summary>
##	Execute steam_exec_t in the steam domain.
## </summary>
## <param name="domain">
## <summary>
##	Domain allowed to transition.
## </summary>
## </param>
#
interface(`steam_domtrans',`
	gen_require(`
		type steam_t, steam_exec_t;
	')

	corecmd_search_bin($1)
	domtrans_pattern($1, steam_exec_t, steam_t)
')

######################################
## <summary>
##	Execute steam in the caller domain.
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed access.
##	</summary>
## </param>
#
interface(`steam_exec',`
	gen_require(`
		type steam_exec_t;
	')

	corecmd_search_bin($1)
	can_exec($1, steam_exec_t)
')

########################################
## <summary>
##	Execute steam in the steam domain, and
##	allow the specified role the steam domain.
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed to transition
##	</summary>
## </param>
## <param name="role">
##	<summary>
##	The role to be allowed the steam domain.
##	</summary>
## </param>
#
interface(`steam_run',`
	gen_require(`
		type steam_t;
		attribute_role steam_roles;
	')

	steam_domtrans($1)
	roleattribute $2 steam_roles;
')

########################################
## <summary>
##	Role access for steam
## </summary>
## <param name="role">
##	<summary>
##	Role allowed access
##	</summary>
## </param>
## <param name="domain">
##	<summary>
##	User domain for the role
##	</summary>
## </param>
#
interface(`steam_role',`
	gen_require(`
		type steam_t;
		attribute_role steam_roles;
	')

	roleattribute $1 steam_roles;

	steam_domtrans($2)

	ps_process_pattern($2, steam_t)
	allow $2 steam_t:process { signull signal sigkill };
')
